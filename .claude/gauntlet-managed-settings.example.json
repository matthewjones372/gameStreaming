{
  "allowManagedHooksOnly": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gauntlet hook stop",
            "statusMessage": "Gauntlet is checking the change (build, tests, coverage)…",
            "timeout": 1800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "gauntlet hook pre-tool-use"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(*.sbt)",
      "Write(*.sbt)",
      "MultiEdit(*.sbt)",
      "NotebookEdit(*.sbt)",
      "Edit(.gauntlet/**)",
      "Write(.gauntlet/**)",
      "MultiEdit(.gauntlet/**)",
      "NotebookEdit(.gauntlet/**)",
      "Edit(.jvmopts)",
      "Write(.jvmopts)",
      "MultiEdit(.jvmopts)",
      "NotebookEdit(.jvmopts)",
      "Edit(.sbtopts)",
      "Write(.sbtopts)",
      "MultiEdit(.sbtopts)",
      "NotebookEdit(.sbtopts)",
      "Edit(.scalafix.conf)",
      "Write(.scalafix.conf)",
      "MultiEdit(.scalafix.conf)",
      "NotebookEdit(.scalafix.conf)",
      "Edit(project/**)",
      "Write(project/**)",
      "MultiEdit(project/**)",
      "NotebookEdit(project/**)",
      "Edit(src/test/resources/**)",
      "Write(src/test/resources/**)",
      "MultiEdit(src/test/resources/**)",
      "NotebookEdit(src/test/resources/**)",
      "Edit(stryker4s.conf)",
      "Write(stryker4s.conf)",
      "MultiEdit(stryker4s.conf)",
      "NotebookEdit(stryker4s.conf)"
    ]
  }
}
